# Copia este archivo a .env y rellena tus valores. .env está en .gitignore.

# --- Autenticación en politicaexterior.com (elige UNA de las dos vías) ---

# Vía A (recomendada): exporta las cookies de tu sesión de navegador ya logueada
# con una extensión tipo "Get cookies.txt LOCALLY" y guárdalas en data/cookies.txt
PE_COOKIES_FILE=data/cookies.txt

# Vía B: login automático con tus credenciales de suscriptor (WordPress)
# PE_USERNAME=tu_email
# PE_PASSWORD=tu_password

# --- Base de datos en Railway ---
# En Railway: New > Database > PostgreSQL, y copia la DATABASE_PUBLIC_URL aquí
# DATABASE_URL=postgresql://postgres:xxxx@xxxx.proxy.rlwy.net:12345/railway
